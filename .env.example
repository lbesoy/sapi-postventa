# ===================================================
# SAPI - Eurorep Postventa
# Plantilla de Variables de Entorno (Ejemplo)
# Copia este archivo como .env y asigna los valores reales
# ===================================================

# --- Supabase (Base de Datos & Auth) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-secret-key

# --- Servidor Local / Backend ---
PORT=3005

# --- SAP Business One Service Layer (Opcional / Backend) ---
SAP_SL_URL=https://tu-servidor-sap:50000/b1s/v1/
SAP_COMPANY_DB=EUROREP_PRODUCCION
SAP_USER=manager
SAP_PASSWORD=tu_password_sap
SAP_REJECT_UNAUTHORIZED=false

# --- Notificaciones SMTP / Correo ---
SMTP_EMAIL=notificaciones@eurorep.com.mx
SMTP_PASSWORD=tu_password_smtp

# --- Asistente de IA (Opcional) ---
GEMINI_API_KEY=tu_gemini_api_key
