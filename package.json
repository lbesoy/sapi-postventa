{
  "scripts": {
    "dev": "vite",
    "dev:3005": "vite --port 3005",
    "dev:serve": "npx -y serve . -l 5000",
    "build:html": "node scripts/build-html.mjs",
    "watch:html": "node scripts/build-html.mjs --watch",
    "build:vite": "node scripts/build-html.mjs && vite build",
    "preview": "vite preview",
    "backend": "node backend/server.js",
    "backend:3005": "PORT=3005 node backend/server.js",
    "check": "node scripts/build-html.mjs --check && node scripts/verify-assets.js",
    "test": "node scripts/test-utils.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "cap:sync": "npm run build:mobile && npx cap sync android",
    "cap:copy": "npm run build:mobile && npx cap copy android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.105.3",
    "axios": "^1.16.1",
    "jsdom": "^29.1.1",
    "nodemailer": "^8.0.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "vite": "^8.3.1"
  }
}
